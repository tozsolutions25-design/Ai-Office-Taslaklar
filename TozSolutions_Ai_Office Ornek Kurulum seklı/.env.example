# TOZ AI Office - example environment file.
# Copy to `.env` and fill in real values locally. `.env` is git-ignored.
#
# This file contains NO real credentials. Every value below is a placeholder or
# a non-sensitive setting. Never commit a filled-in copy of this file.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Required. One of: development | test | staging | production
TOZ_ENV=development

# ---------------------------------------------------------------------------
# Logging / audit
# ---------------------------------------------------------------------------
# One of: silent | error | warn | info | debug | trace
TOZ_LOG_LEVEL=info
# Set to "true" to enable append-only audit event recording.
TOZ_AUDIT_ENABLED=true
# Maximum in-memory audit events retained before oldest are dropped.
TOZ_AUDIT_MAX_EVENTS=10000

# ---------------------------------------------------------------------------
# Concurrency (physical: actual simultaneous external calls)
# ---------------------------------------------------------------------------
TOZ_CONCURRENCY_GLOBAL_MAX=8
TOZ_CONCURRENCY_QUEUE_MAX=1000

# ---------------------------------------------------------------------------
# Queue
# ---------------------------------------------------------------------------
TOZ_QUEUE_MAX_TASKS=10000

# ---------------------------------------------------------------------------
# Retry
# ---------------------------------------------------------------------------
TOZ_RETRY_MAX_ATTEMPTS=3
TOZ_RETRY_BACKOFF_KIND=exponential
TOZ_RETRY_BASE_DELAY_MS=500
TOZ_RETRY_MAX_DELAY_MS=30000

# ---------------------------------------------------------------------------
# Health monitoring
# ---------------------------------------------------------------------------
TOZ_HEALTH_INTERVAL_MS=60000
TOZ_HEALTH_FAILURE_THRESHOLD=3

# ---------------------------------------------------------------------------
# Request timeouts
# ---------------------------------------------------------------------------
TOZ_REQUEST_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Provider credentials
# ---------------------------------------------------------------------------
# PHASE 01 registers NO providers and resolves NO secrets.
# Providers are configured later via a secret *reference* (env var name only).
# Never place a literal key value in configuration or in a provider record.
#
# TOZ_PROVIDER_EXAMPLE_API_KEY_ENV=MY_PROVIDER_API_KEY

# ---------------------------------------------------------------------------
# Provider / model routing (PHASE 06)
# ---------------------------------------------------------------------------
# PHASE 06 registers NO providers and reads NO credentials. It supplies the
# routing, fallback, health and usage machinery that a provider would plug into.
# There is no price table and no quality benchmark anywhere in this repository:
# both would be invented data, and both are read by a routing policy.
#
# One of: capability-first | quality-first | latency-sensitive | cost-sensitive
#         | structured-output
# An unrecognised name is a CONFIGURATION error, reported at load, rather than
# silently falling back to a different policy than the one you believe is set.
# TOZ_ROUTING_POLICY=capability-first

# Maximum fallback hops, including the primary. Bounded on purpose: an unbounded
# chain over a slow provider is a latency budget nobody agreed to.
# TOZ_ROUTING_MAX_FALLBACK_HOPS=3

# How long a failed provider is skipped, in ms. This is the anti-loop guard.
# Setting it to 0 disables the guard, which is a deliberate choice and not a
# default: without it the router re-selects whatever just failed and loops.
# TOZ_ROUTING_FALLBACK_COOLDOWN_MS=60000

# Whether a route with no fallback behind it may still be taken. Defaults to
# true, so a single-provider deployment can still run.
# TOZ_ROUTING_ALLOW_UNPROTECTED=true

# ---------------------------------------------------------------------------
# Autonomous workflows / background workers (PHASE 07)
# ---------------------------------------------------------------------------
# PHASE 07 registers NO scheduler and adds NO dependency. It supplies the job
# state authority, bounded concurrency, claims, checkpoints, approval gates and
# the honest delivery semantics.
#
# Hard ceiling on simultaneously executing tasks, across all jobs. There is no
# "unlimited" value: this number is the only thing standing between a slow
# provider and a stampede.
# TOZ_WORKFLOW_MAX_CONCURRENCY=4

# Default attempts for a task that states none. Must be at least 1.
# TOZ_WORKFLOW_DEFAULT_MAX_ATTEMPTS=3

# Default per-task timeout, in ms.
# TOZ_WORKFLOW_DEFAULT_TIMEOUT_MS=60000

# How long a claim is honoured before it is treated as abandoned. Expiry is what
# makes a crashed worker's task recoverable rather than stuck.
# TOZ_WORKFLOW_CLAIM_TTL_MS=30000

# Retry backoff, base and ceiling. The base may not exceed the ceiling.
# TOZ_WORKFLOW_BACKOFF_BASE_MS=500
# TOZ_WORKFLOW_BACKOFF_MAX_MS=30000

# Whether a job may stop for an approval gate at all. On by default: the safer
# assumption is that the gate exists and must be passed.
# TOZ_WORKFLOW_ALLOW_APPROVAL=true

# ---------------------------------------------------------------------------
# Governance / policy / control plane (PHASE 08)
# ---------------------------------------------------------------------------
# PHASE 08 registers NO policy store and adds NO dependency. It supplies the
# centralised operation catalogue, the four-valued decision, the security context
# and bounded delegation.
#
# Whether a DENY actually stops work. TRUE by default: a control plane that ships
# advisory is not a control plane, and the difference is invisible until needed.
# TOZ_GOVERNANCE_ENFORCED=true

# Whether a cost budget that cannot be evaluated BLOCKS. TRUE by default and the
# safe direction: an unknown cost is not a zero cost, so a budget that read it as
# zero could never fail. This preserves the PHASE 07 rule rather than relaxing it.
# TOZ_GOVERNANCE_BLOCK_ON_UNKNOWN_COST=true

# Comma-separated operation names that ALWAYS require a human approval. Operation
# names are validated against the catalogue, so a typo is reported rather than
# silently reading as "no approval required".
# TOZ_GOVERNANCE_APPROVAL_REQUIRED=approval.resolve,admin.configure

# Comma-separated operations handed back to the subsystem that already owns them.
# This is how PHASE 05 memory authority and PHASE 06 routing stay authoritative
# rather than being shadowed by a second opinion.
# TOZ_GOVERNANCE_DEFER_TO_SUBSYSTEM=memory.read

# Governance ceilings. Each is a positive integer, or unset for no limit. Zero is
# NOT "no limit" - a zero limit is a limit nothing can satisfy, and is rejected.
# TOZ_GOVERNANCE_MAX_CONCURRENT=8
# TOZ_GOVERNANCE_MAX_ATTEMPTS_PER_ACTOR=5
# TOZ_GOVERNANCE_MAX_RUNTIME_MS=30000
